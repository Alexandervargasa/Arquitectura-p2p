# Copia este archivo a .env.peer en cada instancia y ajusta los valores.
#
# SELF_ADDRESS: IP PRIVADA (no la publica) de ESTA instancia + puerto.
#   Usar la IP privada es obligatorio: los Security Groups de AWS solo
#   reconocen la regla "origen = el propio Security Group" cuando el
#   trafico viaja por IP privada dentro de la VPC. Si usas la IP publica
#   aqui, el gossip peer-a-peer se bloquea con un timeout silencioso
#   aunque la regla del Security Group se vea correcta.
#   Ej: 172.31.16.138:50051
SELF_ADDRESS=CAMBIAR_IP_PRIVADA:50051

# SEED_PEERS: lista separada por comas de peers ya existentes para el
#   gossip, tambien con IP PRIVADA (ver nota de arriba). En el PRIMER
#   peer del cluster, dejar vacio. En los demas, apuntar al menos a uno
#   ya vivo. Ej: 172.31.16.138:50051
SEED_PEERS=

# Factor de replicacion (cuantas copias de cada chunk/metadato).
REPLICATION_FACTOR=2

# Tamaño de chunk en MB (ajustar para benchmarking: 8, 10, 16, ...).
CHUNK_SIZE_MB=8

# Peso de capacidad del peer (nodos virtuales ponderados). Una instancia
#   mas grande puede usar PEER_WEIGHT=2 o 3 para recibir mas chunks.
PEER_WEIGHT=1
