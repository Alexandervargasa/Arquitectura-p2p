FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dfsha_pb2.py dfsha_pb2_grpc.py ring_pb2.py ring_pb2_grpc.py ./
COPY common ./common
COPY peer ./peer

ENV DATA_DIR=/data
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 50051

CMD ["python", "-m", "peer.main"]
